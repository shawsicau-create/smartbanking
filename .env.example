# SmartBanking 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统

# MCP 服务器配置
# 邮件服务器配置
EMAIL_PASSWORD=your_email_password_here
EMAIL_USER=your_email@example.com

# 高德地图 API
AMAP_MAPS_API_KEY=your_amap_api_key_here

# 其他可能的环境变量
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 部署平台：Cloudflare Pages
# 使用 wrangler pages deploy 命令部署，无需额外 Token（已通过 wrangler login 授权）
# 部署命令：npx wrangler pages deploy ./dist --project-name=smartbanking
